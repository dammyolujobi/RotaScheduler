@{
    ViewData["Title"] = "Dashboard";
}

<h2>📊 Dashboard</h2>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5 class="card-title">Upcoming Services</h5>
                <p class="display-4">@Model.UpcomingServicesCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">Total Volunteers</h5>
                <p class="display-4">@Model.TotalVolunteers</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5 class="card-title">Active Assignments</h5>
                <p class="display-4">@Model.TotalAssignments</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-dark">
            <div class="card-body">
                <h5 class="card-title">Unfilled Slots</h5>
                <p class="display-4">@Model.UnfilledSlots.Count</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card card-unfilled">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">⚠️ Unfilled Role Slots (Next 30 Days)</h5>
            </div>
            <div class="card-body">
                @if (Model.UnfilledSlots.Any())
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Service</th>
                                <th>Role</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var slot in Model.UnfilledSlots.Take(10))
                            {
                                <tr>
                                    <td>@slot.ServiceDate.ToString("MMM dd")</td>
                                    <td>@slot.ServiceName</td>
                                    <td><span class="badge bg-danger">@slot.RoleName</span></td>
                                    <td>
                                        <a asp-controller="Assignments" asp-action="Create" 
                                           asp-route-serviceId="@slot.ServiceId" 
                                           asp-route-roleId="@slot.RoleId" 
                                           class="btn btn-sm btn-primary">Assign</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (Model.UnfilledSlots.Count > 10)
                    {
                        <p class="text-muted">...and @(Model.UnfilledSlots.Count - 10) more</p>
                    }
                }
                else
                {
                    <p class="text-success mb-0">✓ All roles are filled for upcoming services!</p>
                }
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card card-overdue">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">⏰ Volunteers Overdue for Rotation</h5>
            </div>
            <div class="card-body">
                @if (Model.OverdueVolunteers.Any())
                {
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Volunteer</th>
                                <th>Roles</th>
                                <th>Last Served</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vol in Model.OverdueVolunteers.Take(10))
                            {
                                <tr>
                                    <td>@vol.VolunteerName</td>
                                    <td>@vol.Roles</td>
                                    <td>
                                        @if (vol.DaysSinceLastServed.HasValue)
                                        {
                                            <span>@vol.DaysSinceLastServed days ago</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (Model.OverdueVolunteers.Count > 10)
                    {
                        <p class="text-muted">...and @(Model.OverdueVolunteers.Count - 10) more</p>
                    }
                }
                else
                {
                    <p class="text-success mb-0">✓ All active volunteers have served recently!</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="mt-4">
    <a asp-controller="Services" asp-action="Generate" class="btn btn-lg btn-success">
        ➕ Generate Recurring Services
    </a>
</div>
