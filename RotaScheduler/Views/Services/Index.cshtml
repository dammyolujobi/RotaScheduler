@model IEnumerable<RotaScheduler.Models.Entities.Service>

@{
    ViewData["Title"] = "Services";
}

<div class="container mt-4">
    <h1>Services</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">Create New Service</a>
        <a asp-action="GenerateServices" class="btn btn-success">Generate Recurring Services</a>
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Date</th>
                <th>Time</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderBy(s => s.ServiceDate).ThenBy(s => s.StartTime))
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.ServiceDate.ToString("MMM dd, yyyy")</td>
                    <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                    <td>@(item.IsActive ? "Yes" : "No")</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
