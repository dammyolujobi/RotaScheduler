<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rota Scheduler</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .sidebar {
            min-height: 100vh;
            background-color: #343a40;
        }
        .sidebar a {
            color: rgba(255,255,255,.8);
            text-decoration: none;
            padding: 0.5rem 1rem;
            display: block;
        }
        .sidebar a:hover, .sidebar a.active {
            color: #fff;
            background-color: rgba(255,255,255,.1);
        }
        .card-unfilled {
            border-left: 4px solid #dc3545;
        }
        .card-overdue {
            border-left: 4px solid #ffc107;
        }
        .role-badge {
            font-size: 0.85em;
        }
        .calendar-slot {
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 10px;
            margin-bottom: 10px;
        }
        .calendar-slot.unfilled {
            background-color: #fff5f5;
            border-color: #dc3545;
        }
        .assignment-tag {
            display: inline-block;
            background-color: #e9ecef;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.85em;
            margin: 2px;
        }
        .missing-role {
            color: #dc3545;
            font-style: italic;
        }
    </style>
</head>
<body>
    <div class="container-fluid">
        <div class="row">
            <nav class="col-md-2 d-none d-md-block sidebar p-3">
                <h4 class="text-white mb-4">Rota Scheduler</h4>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a asp-controller="Dashboard" asp-action="Index" class="nav-link">📊 Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Calendar" asp-action="Index" class="nav-link">📅 Calendar</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Services" asp-action="Index" class="nav-link">🙏 Services</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Assignments" asp-action="Index" class="nav-link">📋 Assignments</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Volunteers" asp-action="Index" class="nav-link">👥 Volunteers</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Roles" asp-action="Index" class="nav-link">🎭 Roles</a>
                    </li>
                    <li class="nav-item">
                        <a asp-controller="Unavailabilities" asp-action="Index" class="nav-link">📆 Unavailability</a>
                    </li>
                </ul>
            </nav>
            <main class="col-md-10 ms-sm-auto col-lg-10 px-md-4 py-4">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
