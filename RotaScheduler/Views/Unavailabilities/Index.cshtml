@model IEnumerable<RotaScheduler.Models.Entities.Unavailability>

@{
    ViewData["Title"] = "Unavailability";
}

<div class="container mt-4">
    <h1>Volunteer Unavailability</h1>

    <p>
        <a asp-action="Create" class="btn btn-primary">Add Unavailability</a>
    </p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Volunteer</th>
                <th>Start Date</th>
                <th>End Date</th>
                <th>Reason</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.OrderBy(u => u.StartDate))
            {
                <tr>
                    <td>@item.Volunteer.Name</td>
                    <td>@item.StartDate.ToString("MMM dd, yyyy")</td>
                    <td>@item.EndDate.ToString("MMM dd, yyyy")</td>
                    <td>@item.Reason</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
